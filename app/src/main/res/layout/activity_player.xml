<?xml version="1.0" encoding="utf-8"?>
<!--
  Player (PRD §6.3) — the most important screen in the product (§8.4).

  The frame is full-bleed and every control floats over it. The chrome auto-hides, so for
  most of a film this screen is just the picture.

  **Z-order is behaviour here, not taste.** Front to back: interactive overlays, chrome,
  HUDs, the gesture surface, the frame. `gestures` has to sit above the video to receive
  anything, which means everything the viewer can *press* has to sit above `gestures` — a
  Skip-ad button placed inside `frame`, where it used to live, would be invisible to touch.
  The chrome itself is not clickable where it is empty, so taps between its buttons fall
  through to `gestures` and toggle it.

  PlayerView keeps use_controller="false": the skip timing, the ad ticks and the data note
  are all specified behaviour, so every control is ours.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg"
    tools:context=".ui.player.PlayerActivity">

    <!-- ============================================ the frame -->
    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <View
            android:id="@+id/vignette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vignette_player"
            android:importantForAccessibility="no" />

        <!-- Buffering: an ember arc, the design's own @keyframes mh-spin -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/buffering"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/mh_buffering" />

        <!-- Ad slate, shown while a creative loads -->
        <LinearLayout
            android:id="@+id/adSlate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ad_slate"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campaign"
                app:tint="@color/ad_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ad_label"
                android:textAppearance="@style/TextAppearance.Mh.Meta"
                android:textColor="@color/ad_label" />
        </LinearLayout>

        <!-- 3dp ember bar along the bottom edge while an ad plays -->
        <ProgressBar
            android:id="@+id/adProgress"
            style="@style/Widget.Mh.ProgressBar.Ember"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_progress_height"
            android:layout_gravity="bottom"
            android:visibility="gone"
            tools:visibility="gone" />
    </FrameLayout>

    <!-- ============================================ gestures -->
    <com.example.streamingappzb.ui.widget.PlayerGestureView
        android:id="@+id/gestures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_player_surface" />

    <!-- ============================================ HUDs (never interactive) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/skipLeftHud"
            style="@style/Widget.Mh.Player.SkipHud"
            android:layout_gravity="start|center_vertical"
            android:drawableStart="@drawable/ic_replay_10"
            tools:text="10" />

        <TextView
            android:id="@+id/skipRightHud"
            style="@style/Widget.Mh.Player.SkipHud"
            android:layout_gravity="end|center_vertical"
            android:drawableEnd="@drawable/ic_forward_10"
            tools:text="10" />

        <!-- Brightness and volume share one HUD; only the icon changes. -->
        <LinearLayout
            android:id="@+id/levelHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_r12"
            android:backgroundTint="@color/player_hud_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/levelIcon"
                android:layout_width="@dimen/icon"
                android:layout_height="@dimen/icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brightness"
                app:tint="@color/text_hi" />

            <ProgressBar
                android:id="@+id/levelBar"
                style="@style/Widget.Mh.ProgressBar.Ember"
                android:layout_width="@dimen/player_hud_bar_width"
                android:layout_height="@dimen/seek_track_height"
                android:layout_marginStart="10dp"
                android:max="100" />
        </LinearLayout>

        <!-- Scrub target, while a horizontal drag is in progress. -->
        <TextView
            android:id="@+id/scrubHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_r12"
            android:backgroundTint="@color/player_hud_bg"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textAppearance="@style/TextAppearance.Mh.Num.BodyL"
            android:textColor="@color/text_hi"
            android:visibility="gone"
            tools:text="24:10  +0:38"
            tools:visibility="gone" />
    </FrameLayout>

    <!-- ============================================ chrome -->
    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: close, title, cast, picture-in-picture -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/scrim_player_top"
            android:gravity="center_vertical"
            android:minHeight="@dimen/player_header_height"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/btnClose"
                style="@style/Widget.Mh.IconButton"
                android:contentDescription="@string/cd_close_player"
                android:src="@drawable/ic_keyboard_arrow_down" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Mh.BodyL"
                    tools:text="Nosferatu" />

                <TextView
                    android:id="@+id/playerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    tools:text="Public domain · Internet Archive" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCast"
                style="@style/Widget.Mh.IconButton"
                android:contentDescription="@string/cd_cast"
                android:src="@drawable/ic_cast" />

            <ImageView
                android:id="@+id/btnPip"
                style="@style/Widget.Mh.IconButton"
                android:contentDescription="@string/cd_pip"
                android:src="@drawable/ic_picture_in_picture_alt" />
        </LinearLayout>

        <!--
          The transport sits over the middle of the picture rather than below it. The
          surrounding space is left to `gestures`, which is why this wrapper is not
          clickable and has no background.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/transport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnReplay10"
                    style="@style/Widget.Mh.IconButton"
                    android:contentDescription="@string/cd_back_10"
                    android:src="@drawable/ic_replay_10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPause"
                    style="@style/Widget.Mh.Pill.Ember"
                    android:layout_width="@dimen/play_button"
                    android:layout_height="@dimen/play_button"
                    android:layout_marginStart="@dimen/transport_gap"
                    android:layout_marginEnd="@dimen/transport_gap"
                    android:contentDescription="@string/cd_play"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:cornerRadius="@dimen/radius_pill"
                    app:icon="@drawable/ic_play_arrow_fill"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="@dimen/icon_xxl" />

                <ImageView
                    android:id="@+id/btnForward10"
                    style="@style/Widget.Mh.IconButton"
                    android:contentDescription="@string/cd_forward_10"
                    android:src="@drawable/ic_forward_10" />
            </LinearLayout>
        </FrameLayout>

        <!-- Controls -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/scrim_player_bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/player_controls_padding_h"
            android:paddingTop="@dimen/player_controls_padding_t"
            android:paddingEnd="@dimen/player_controls_padding_h"
            android:paddingBottom="@dimen/player_controls_padding_b">

            <com.example.streamingappzb.ui.widget.SeekRailView
                android:id="@+id/seekRail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seek_touch_height" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Caption"
                    tools:text="18:42" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Caption"
                    tools:text="1:34:10" />

                <!--
                  Bottom-right, where a player's fullscreen control is expected. Rotation
                  was previously only reachable by turning the device, which does nothing
                  at all when the system's auto-rotate is off.
                -->
                <ImageView
                    android:id="@+id/btnFullscreen"
                    style="@style/Widget.Mh.IconButton"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/cd_fullscreen"
                    android:src="@drawable/ic_fullscreen" />
            </LinearLayout>

            <!-- Fixed chips: no sideways scroll. The quality chip carries the data cost. -->
            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubtitles"
                    style="@style/Widget.Mh.Pill.PlayerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:contentDescription="@string/cd_subtitles"
                    android:text="@string/subtitles_english"
                    app:icon="@drawable/ic_closed_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuality"
                    style="@style/Widget.Mh.Pill.QualityChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:layout_marginStart="@dimen/gap_button_tight"
                    android:contentDescription="@string/cd_quality"
                    app:icon="@drawable/ic_speed"
                    tools:text="240p · 155 MB/hr" />

                <!-- Only shown when the title resolved to more than one legal source. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSource"
                    style="@style/Widget.Mh.Pill.PlayerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:layout_marginStart="@dimen/gap_button_tight"
                    android:contentDescription="@string/cd_switch_source"
                    android:visibility="gone"
                    app:icon="@drawable/ic_swap"
                    tools:text="Source 1/3"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.Mh.Pill.PlayerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:layout_marginStart="@dimen/gap_button_tight"
                    android:contentDescription="@string/cd_next_episode"
                    android:text="@string/action_next"
                    app:icon="@drawable/ic_skip_next" />
            </LinearLayout>

            <!-- The data note: cyan when Saver is actually saving something -->
            <TextView
                android:id="@+id/dataNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Mh.Caption"
                android:textColor="@color/text_low"
                tools:text="Mobile data · Data Saver caps streams at 360p" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================ interactive overlays, above gestures -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Time left on the ad -->
        <TextView
            android:id="@+id/adBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/player_header_height"
            android:background="@drawable/bg_r4"
            android:backgroundTint="@color/ad_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textAppearance="@style/TextAppearance.Mh.Num.Caption"
            android:textColor="@color/ember400"
            android:visibility="gone"
            tools:text="Ad · 0:12"
            tools:visibility="gone" />

        <!-- Skip: "Skip in 5…1" then "Skip ad ›" at exactly 5s (acceptance item 8) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipAd"
            style="@style/Widget.Mh.Pill.Ember"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/skip_button_height"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="@dimen/player_overlay_bottom"
            android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold"
            android:visibility="gone"
            app:cornerRadius="@dimen/radius_badge_sm"
            tools:text="Skip ad ›"
            tools:visibility="gone" />

        <!-- Up next (FR-206) -->
        <LinearLayout
            android:id="@+id/upNextCard"
            android:layout_width="@dimen/upnext_card_width"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="@dimen/player_overlay_bottom"
            android:background="@drawable/bg_r12"
            android:backgroundTint="@color/upnext_card_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.streamingappzb.ui.widget.CountdownRingView
                    android:id="@+id/upNextRing"
                    android:layout_width="@dimen/upnext_ring"
                    android:layout_height="@dimen/upnext_ring" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/up_next"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.Mh.Micro.Eleven"
                        android:textColor="@color/text_mid" />

                    <TextView
                        android:id="@+id/upNextEpisode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold"
                        android:textColor="@color/text_hi"
                        tools:text="Ep 5 · Verdict" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpNextCancel"
                    style="@style/Widget.Mh.Pill.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/action_cancel"
                    android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpNextPlay"
                    style="@style/Widget.Mh.Pill.Ember"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/action_play_now"
                    android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
