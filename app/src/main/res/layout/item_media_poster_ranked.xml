<?xml version="1.0" encoding="utf-8"?>
<!--
  One title in the ranked (Top 10) discover row.

  Same poster, badges and caption as item_media_poster, with the rank numeral added to its
  start. Declaration order is the z-order: the numeral comes first so the poster column
  draws over it, which is what makes the glyph read as a cut-out behind the card.

  The caption sits in the poster's column rather than under the whole slot, so it stays
  aligned with the poster edge instead of starting under the numeral.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/gap_poster"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:orientation="horizontal">

    <com.example.streamingappzb.ui.widget.RankNumeralView
        android:id="@+id/rankNumeral"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/poster_row_height" />

    <LinearLayout
        android:layout_width="@dimen/poster_row_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rank_poster_overlap"
        android:orientation="vertical"
        tools:ignore="NegativeMargin">

        <com.example.streamingappzb.ui.widget.PosterView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="@dimen/poster_row_height"
            android:importantForAccessibility="no"
            app:mhCornerRadius="@dimen/radius_poster_row"
            app:mhShowLabel="true">

            <!-- Top-end so it never collides with the drawn title at the bottom. -->
            <TextView
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_rating_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textAppearance="@style/TextAppearance.Mh.Num.Micro"
                android:textColor="@color/ember400"
                android:visibility="gone"
                tools:text="8.4"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/comingStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/rose500"
                android:gravity="center"
                android:paddingTop="@dimen/new_strip_padding_v"
                android:paddingBottom="@dimen/new_strip_padding_v"
                android:textAppearance="@style/TextAppearance.Mh.Micro"
                android:textColor="@color/text_hi"
                android:visibility="gone"
                tools:text="COMING 12 MAR"
                tools:visibility="visible" />
        </com.example.streamingappzb.ui.widget.PosterView>

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Mh.Num.Caption"
            tools:text="2024 · Film" />
    </LinearLayout>
</LinearLayout>
