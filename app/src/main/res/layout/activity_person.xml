<?xml version="1.0" encoding="utf-8"?>
<!--
  A person and their filmography, reached by tapping a face on a title screen.

  Films and series are separate rows rather than one merged list: a working actor has both,
  and a mixed list sorted by date reads as noise. Either row is hidden when empty.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night900"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:minHeight="@dimen/screen_header_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gutter_appbar"
            android:paddingEnd="@dimen/gutter_appbar"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/Widget.Mh.RoundButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />
        </LinearLayout>

        <!-- Portrait and the biographical facts, side by side. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter">

            <ImageView
                android:id="@+id/photo"
                android:layout_width="@dimen/person_photo"
                android:layout_height="@dimen/person_photo"
                android:background="@drawable/bg_person_photo"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.ScreenTitle"
                    tools:text="Sigourney Weaver" />

                <TextView
                    android:id="@+id/knownFor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    android:textColor="@color/text_mid"
                    tools:text="Acting" />

                <TextView
                    android:id="@+id/born"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Meta"
                    android:visibility="gone"
                    tools:text="1949 · New York City"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/biography"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="6"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:textAppearance="@style/TextAppearance.Mh.Body"
            android:textColor="@color/text_mid"
            android:visibility="gone"
            tools:text="Biography text."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/filmsHeading"
            style="@style/Widget.Mh.RowHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_header_height"
            android:layout_marginTop="10dp"
            android:text="@string/person_films"
            android:textAppearance="@style/TextAppearance.Mh.RowTitle"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/films"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gap_poster"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_media_poster" />

        <TextView
            android:id="@+id/seriesHeading"
            style="@style/Widget.Mh.RowHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_header_height"
            android:layout_marginTop="10dp"
            android:text="@string/person_series"
            android:textAppearance="@style/TextAppearance.Mh.RowTitle"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gap_poster"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_media_poster" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:indeterminateTint="@color/ember500"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="@string/error_generic"
            android:textAppearance="@style/TextAppearance.Mh.Body"
            android:textColor="@color/text_mid"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
