<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab host. The bottom nav is a sibling *below* the content rather than an overlay, so a
  tab screen's last row is never hidden behind it.

  A FrameLayout root so MhToastHost can position the in-app toast above the nav.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night900"
    tools:context=".ui.main.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.example.streamingappzb.ui.widget.MhBottomNav
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!--
      Brand reveal, played over the first frame and then faded out. An overlay rather than
      a blocking splash, so it cannot cost anything against the cold-start budget
      (PRD §8: interactive Home in under 2s).
    -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/night900"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:visibility="visible">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/splashAnimation"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/mh_splash_ember" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/wordmark"
            android:textAppearance="@style/TextAppearance.Mh.Wordmark" />
    </FrameLayout>
</FrameLayout>
