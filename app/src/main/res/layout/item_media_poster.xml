<?xml version="1.0" encoding="utf-8"?>
<!--
  One title in a discover row.

  The poster is the original 120x180dp at a 6dp radius. Two things are added for real
  catalogue data: a rating badge, because TMDB scores are the main signal a viewer sorts
  on, and a "COMING" strip for a title that has not been released, which stops an
  unreleased film looking like something you can watch tonight.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/poster_row_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/gap_poster"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <com.example.streamingappzb.ui.widget.PosterView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="@dimen/poster_row_height"
        app:mhCornerRadius="@dimen/radius_poster_row"
        app:mhShowLabel="true">

        <!-- Top-end so it never collides with the drawn title at the bottom. -->
        <TextView
            android:id="@+id/rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rating_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textAppearance="@style/TextAppearance.Mh.Num.Micro"
            android:textColor="@color/ember400"
            android:visibility="gone"
            tools:text="8.4"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/comingStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/rose500"
            android:gravity="center"
            android:paddingTop="@dimen/new_strip_padding_v"
            android:paddingBottom="@dimen/new_strip_padding_v"
            android:textAppearance="@style/TextAppearance.Mh.Micro"
            android:textColor="@color/text_hi"
            android:visibility="gone"
            tools:text="COMING 12 MAR"
            tools:visibility="visible" />
    </com.example.streamingappzb.ui.widget.PosterView>

    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Mh.Num.Caption"
        tools:text="2024 · Film" />
</LinearLayout>
