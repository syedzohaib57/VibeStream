<?xml version="1.0" encoding="utf-8"?>
<!--
  Title detail's header (PRD §6.2): backdrop, title, metadata, the primary resume button,
  My List, Download, then the synopsis and cast.

  Download is present only when the rights record allows it (acceptance item 11) — the
  button is removed, not merely disabled, so there is nothing to tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_backdrop_height">

        <com.example.streamingappzb.ui.widget.PosterView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:mhCornerRadius="0dp"
            app:mhShowLabel="false" />

        <com.example.streamingappzb.ui.widget.RosetteView
            android:id="@+id/rosette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:mhHaloSize="@dimen/title_rosette" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_title_backdrop"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/title_overlap"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_title"
        android:paddingEnd="@dimen/gutter_title">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Mh.TitleXL"
            tools:text="Moonlit Night" />

        <!-- Scrolls rather than wraps, so font scale 1.3 cannot squash it (PRD §8). -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Meta"
                    tools:text="2022 · 17 episodes · Romance · Family" />

                <TextView
                    android:id="@+id/ccBadge"
                    style="@style/Widget.Mh.Badge.CC"
                    android:layout_marginStart="8dp"
                    android:text="@string/badge_cc" />

                <!-- cyan = offline (PRD §2.1) -->
                <LinearLayout
                    android:id="@+id/downloadableChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_offline_pin"
                        app:tint="@color/cyan400" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="@string/downloadable"
                        android:textAppearance="@style/TextAppearance.Mh.Caption"
                        android:textColor="@color/cyan400" />
                </LinearLayout>

                <TextView
                    android:id="@+id/streamOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/stream_only"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    android:textColor="@color/text_low"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            style="@style/Widget.Mh.Pill.Ember"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_primary_height"
            android:layout_marginTop="16dp"
            android:text="@string/action_play"
            app:icon="@drawable/ic_play_arrow_fill" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_button"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyList"
                style="@style/Widget.Mh.Pill.Ghost"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="@string/action_my_list"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                style="@style/Widget.Mh.Pill.Cyan"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/gap_button_tight"
                android:layout_weight="1"
                android:text="@string/action_download"
                app:icon="@drawable/ic_download" />
        </LinearLayout>

        <TextView
            android:id="@+id/synopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.Mh.Body"
            android:textColor="@color/text_mid"
            android:textSize="15sp"
            tools:text="A schoolteacher returns to her father's house the winter his debts come due." />

        <TextView
            android:id="@+id/cast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Mh.Meta"
            android:textColor="@color/text_low"
            tools:text="With Areeba Khalil, Faraz Noorani" />
    </LinearLayout>
</LinearLayout>
