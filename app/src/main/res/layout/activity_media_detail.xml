<?xml version="1.0" encoding="utf-8"?>
<!--
  Title detail, over real catalogue data.

  The order answers the viewer's questions in the order they ask them: what is this, can I
  watch it, where, what's in it. "Where to watch" is therefore above the synopsis, not
  buried under it — it is the reason this screen exists.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night900">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.example.streamingappzb.ui.widget.PosterView
                    android:id="@+id/backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/title_backdrop_height"
                    app:mhCornerRadius="0dp"
                    app:mhPosterStyle="hero"
                    app:mhShowLabel="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/title_backdrop_height"
                    android:background="@drawable/scrim_title_backdrop"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.TitleXL"
                    tools:text="Dune: Part Two" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tagline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Mh.Meta"
                    android:textColor="@color/ember400"
                    android:visibility="gone"
                    tools:text="Long live the fighters"
                    tools:visibility="visible" />

                <!-- Primary action. Its label is decided by ResolvePlaybackUseCase. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimary"
                    style="@style/Widget.Mh.Pill.Ember"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_primary_height"
                    android:layout_marginTop="16dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"
                    android:ellipsize="end"
                    android:singleLine="true"
                    tools:text="Where to watch" />

                <TextView
                    android:id="@+id/playableNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    android:textColor="@color/cyan400"
                    android:visibility="gone"
                    tools:text="Public domain · Internet Archive"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_button"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMyList"
                        style="@style/Widget.Mh.Pill.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_primary_height"
                        android:layout_weight="1"
                        android:text="@string/action_my_list"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondary"
                        style="@style/Widget.Mh.Pill.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_primary_height"
                        android:layout_marginStart="@dimen/gap_button"
                        android:layout_weight="1"
                        android:text="@string/action_trailer"
                        android:visibility="gone"
                        app:icon="@drawable/ic_play_circle_fill"
                        app:iconGravity="textStart"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- ============== Where to watch ============== -->

                <TextView
                    android:id="@+id/watchHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/section_where_to_watch"
                    android:textAppearance="@style/TextAppearance.Mh.Section" />

                <TextView
                    android:id="@+id/watchRegion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    tools:text="Availability in Pakistan" />

                <LinearLayout
                    android:id="@+id/watchGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/watchEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Mh.Body"
                    android:textColor="@color/text_mid"
                    android:visibility="gone"
                    tools:text="No streaming service carries this in Pakistan yet."
                    tools:visibility="visible" />

                <!-- TMDB's terms require this attribution wherever provider data is shown. -->
                <TextView
                    android:id="@+id/attribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/watch_attribution"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    android:textColor="@color/text_low" />

                <!-- ============== Synopsis and cast ============== -->

                <TextView
                    android:id="@+id/overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="@style/TextAppearance.Mh.Body"
                    android:textColor="@color/text_mid"
                    tools:text="Paul Atreides unites with the Fremen…" />

                <TextView
                    android:id="@+id/castHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/section_cast"
                    android:textAppearance="@style/TextAppearance.Mh.Section"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_cast" />

            <!-- ============== Seasons and episodes ============== -->

            <LinearLayout
                android:id="@+id/episodesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/section_episodes"
                    android:textAppearance="@style/TextAppearance.Mh.Section" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/seasonChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_media_episode" />
            </LinearLayout>

            <!-- ============== Crew ============== -->

            <TextView
                android:id="@+id/crewHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:text="@string/detail_crew_heading"
                android:textAppearance="@style/TextAppearance.Mh.Section"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/crew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_cast" />

            <!-- ============== The collection this film belongs to ============== -->

            <TextView
                android:id="@+id/collectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:textAppearance="@style/TextAppearance.Mh.Section"
                android:visibility="gone"
                tools:text="The Lord of the Rings collection"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gap_poster"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_media_poster" />

            <!-- ============== Recommendations ============== -->

            <TextView
                android:id="@+id/relatedHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:text="@string/detail_recommended"
                android:textAppearance="@style/TextAppearance.Mh.Section"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/related"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gap_poster"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_media_poster" />

            <!-- ============== Studios and broadcasters ============== -->

            <TextView
                android:id="@+id/studiosHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:textAppearance="@style/TextAppearance.Mh.Section"
                android:visibility="gone"
                tools:text="Studios"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/studiosScroller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/gutter"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/studios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ember500"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/night900"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_offline_body"
            android:textAppearance="@style/TextAppearance.Mh.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.Mh.Pill.Ember"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="16dp"
            android:text="@string/action_retry" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/title_actions_inset"
        android:paddingTop="@dimen/title_actions_top"
        android:paddingEnd="@dimen/title_actions_inset">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Mh.RoundButton"
            android:layout_gravity="start"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <ImageView
            android:id="@+id/btnShare"
            style="@style/Widget.Mh.RoundButton"
            android:layout_gravity="end"
            android:contentDescription="@string/cd_share"
            android:padding="10dp"
            android:src="@drawable/ic_share" />
    </FrameLayout>
</FrameLayout>
