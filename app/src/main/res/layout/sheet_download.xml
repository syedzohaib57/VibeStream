<?xml version="1.0" encoding="utf-8"?>
<!--
  Download sheet (FR-301..303).

  Each rung row shows its size in MB **before anything starts** (FR-302). On mobile data
  with Wi-Fi-only on, the primary reads "Queue for Wi-Fi" and a secondary offers
  "Use mobile data now" — the viewer is never charged for data by default.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/night500"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingEnd="@dimen/sheet_padding_h"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.Mh.Section"
        tools:text="Download episode 4" />

    <LinearLayout
        android:id="@+id/rungs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/sheet_padding_h">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            style="@style/Widget.Mh.Pill.Ember"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/action_download"
            tools:icon="@drawable/ic_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Widget.Mh.Pill.Ghost"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/gap_button_tight"
            android:text="@string/use_mobile_data_now"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_button_tight"
            android:gravity="center"
            android:text="@string/download_wifi_note"
            android:textAppearance="@style/TextAppearance.Mh.Caption"
            android:textColor="@color/text_low"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
