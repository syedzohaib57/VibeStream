<?xml version="1.0" encoding="utf-8"?>
<!--
  The generic sheet shell (PRD §5 `MhSheet`), shared by the quality, subtitle and data
  sheets: a handle, a title, an optional header block, a divider, the rows, and a footer.

  `night800`, 22dp top corners and the 60% scrim come from
  ThemeOverlay.Mh.BottomSheet rather than being set here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="@dimen/sheet_handle_width"
        android:layout_height="@dimen/sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/night500"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingEnd="@dimen/sheet_padding_h"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.Mh.Section"
        tools:text="Streaming quality" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginStart="@dimen/sheet_padding_h"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/sheet_padding_h"
        android:layout_marginBottom="6dp"
        android:background="@color/night600"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sheet_padding_h"
        android:paddingEnd="@dimen/sheet_padding_h" />
</LinearLayout>
