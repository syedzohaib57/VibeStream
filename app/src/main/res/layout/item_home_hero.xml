<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero banner (PRD §6.1). 580dp, full-bleed, **a still image only — never autoplays**
  (FR-210): there is no player surface in this layout at all.

  Copy is left-aligned 22dp from the bottom and 20dp from the sides. The metadata row sits
  in a HorizontalScrollView because it must never wrap and its items must never shrink —
  at font scale 1.3 it scrolls instead (PRD §8).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hero_height">

    <com.example.streamingappzb.ui.widget.PosterView
        android:id="@+id/heroPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:mhCornerRadius="0dp"
        app:mhPosterStyle="hero"
        app:mhShowLabel="false" />

    <com.example.streamingappzb.ui.widget.RosetteView
        android:id="@+id/heroRosette"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:mhHaloSize="@dimen/hero_rosette" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_hero_v"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_hero_h"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/hero_copy_bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_hero"
        android:paddingEnd="@dimen/gutter_hero">

        <!-- Eyebrow: a 14x2dp ember bar, then TODAY'S PICK -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/hero_eyebrow_bar_w"
                android:layout_height="@dimen/hero_eyebrow_bar_h"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/ember500"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/hero_eyebrow"
                android:textAppearance="@style/TextAppearance.Mh.Eyebrow" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hero_copy_gap"
            android:maxWidth="@dimen/hero_title_max_width"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Mh.HeroTitle"
            tools:text="Moonlit Night" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hero_copy_gap"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cyan, and only on a fresh series — never on a Film (acceptance item 4). -->
                <TextView
                    android:id="@+id/heroNewEpisodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/hero_new_episodes"
                    android:textAppearance="@style/TextAppearance.Mh.Meta.Semibold"
                    android:textColor="@color/cyan400"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/heroYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Meta"
                    tools:text="2022" />

                <TextView
                    android:id="@+id/heroHd"
                    style="@style/Widget.Mh.Badge.HD"
                    android:layout_marginStart="8dp"
                    android:text="@string/badge_hd" />

                <TextView
                    android:id="@+id/heroRuntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Meta"
                    tools:text="17 episodes" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/heroGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hero_copy_gap"
            android:alpha="0.86"
            android:textAppearance="@style/TextAppearance.Mh.Meta"
            android:textColor="@color/text_hi"
            tools:text="Romance • Family" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeroPlay"
                style="@style/Widget.Mh.Pill.HeroEmber"
                android:layout_width="0dp"
                android:layout_height="@dimen/hero_button_height"
                android:layout_weight="1"
                android:text="@string/action_play"
                app:icon="@drawable/ic_play_arrow_fill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeroMyList"
                style="@style/Widget.Mh.Pill.HeroGhost"
                android:layout_width="0dp"
                android:layout_height="@dimen/hero_button_height"
                android:layout_marginStart="@dimen/gap_button"
                android:layout_weight="1"
                android:text="@string/action_my_list"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeroInfo"
                style="@style/Widget.Mh.Pill.HeroGhost"
                android:layout_width="@dimen/hero_button_height"
                android:layout_height="@dimen/hero_button_height"
                android:layout_marginStart="@dimen/gap_button"
                android:contentDescription="@string/cd_more_info"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_info"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="21dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
