    <!-- ===== Chips ===== -->
    <!--
      The design's chip is 32dp. The view is 44dp so the touch target clears the minimum,
      with the difference inset out of the background — the chips row already reserves
      46dp, so nothing moves.
    -->
    <dimen name="chip_height">32dp</dimen>
    <dimen name="chip_touch_height">@dimen/touch_min</dimen>
    <dimen name="chip_touch_inset_v">6dp</dimen>
    <dimen name="chip_padding_h">14dp</dimen>
    <dimen name="chip_stroke">1dp</dimen>

    <!-- ===== Hero ===== -->
