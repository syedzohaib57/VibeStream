    <dimen name="hero_copy_bottom">22dp</dimen>
    <dimen name="hero_title_max_width">320dp</dimen>
    <dimen name="hero_copy_gap">6dp</dimen>
    <dimen name="hero_eyebrow_bar_w">14dp</dimen>
    <dimen name="hero_eyebrow_bar_h">2dp</dimen>
    <dimen name="hero_button_height">44dp</dimen>
    <dimen name="hero_rosette">320dp</dimen>

