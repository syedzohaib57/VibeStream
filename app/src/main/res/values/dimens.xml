    <dimen name="new_dot">7dp</dimen>
    <dimen name="new_strip_padding_v">4dp</dimen>

    <!-- Ranked (Top 10) rows. The overlap is negative on purpose: the poster sits over
         the numeral's right edge, which is what makes the glyph read as a cut-out. -->
    <dimen name="rank_numeral_stroke_width">2dp</dimen>
    <dimen name="rank_poster_overlap">-46dp</dimen>
    <!-- How much of the glyph has to stay clear of the poster. Without a floor, the fixed
         overlap above swallows a narrow "1" almost entirely while leaving a "2" readable. -->
    <dimen name="rank_numeral_min_visible">30dp</dimen>
    <dimen name="rank_row_gutter_end">26dp</dimen>

    <!-- ===== Title detail ===== -->
    <dimen name="title_backdrop_height">300dp</dimen>

