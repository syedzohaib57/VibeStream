<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape player: fullscreen video with **the same controls** overlaid (PRD §6.3).

  Every id from the portrait layout appears here with the same view type, so view binding
  stays non-null and PlayerActivity needs no orientation branching at all — only the
  hierarchy differs, not the contract.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.player.PlayerActivity">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <View
            android:id="@+id/vignette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vignette_player"
            android:importantForAccessibility="no" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/buffering"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/mh_buffering" />

        <LinearLayout
            android:id="@+id/adSlate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ad_slate"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campaign"
                app:tint="@color/ad_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ad_label"
                android:textAppearance="@style/TextAppearance.Mh.Meta"
                android:textColor="@color/ad_label" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/adProgress"
            style="@style/Widget.Mh.ProgressBar.Ember"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_progress_height"
            android:layout_gravity="bottom"
            android:visibility="gone" />
    </FrameLayout>

    <!--
      Gestures and HUDs, identical to the portrait layout.

      Not optional duplication: ViewBinding types any id missing from a variant as nullable,
      so leaving these out of landscape would make every one of them nullable in *both*
      layouts and push null handling into the Activity for views that always exist.
    -->
    <com.example.streamingappzb.ui.widget.PlayerGestureView
        android:id="@+id/gestures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_player_surface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/skipLeftHud"
            style="@style/Widget.Mh.Player.SkipHud"
            android:layout_gravity="start|center_vertical"
            android:drawableStart="@drawable/ic_replay_10"
            tools:text="10" />

        <TextView
            android:id="@+id/skipRightHud"
            style="@style/Widget.Mh.Player.SkipHud"
            android:layout_gravity="end|center_vertical"
            android:drawableEnd="@drawable/ic_forward_10"
            tools:text="10" />

        <LinearLayout
            android:id="@+id/levelHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_r12"
            android:backgroundTint="@color/player_hud_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/levelIcon"
                android:layout_width="@dimen/icon"
                android:layout_height="@dimen/icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brightness"
                app:tint="@color/text_hi" />

            <ProgressBar
                android:id="@+id/levelBar"
                style="@style/Widget.Mh.ProgressBar.Ember"
                android:layout_width="@dimen/player_hud_bar_width"
                android:layout_height="@dimen/seek_track_height"
                android:layout_marginStart="10dp"
                android:max="100" />
        </LinearLayout>

        <TextView
            android:id="@+id/scrubHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_r12"
            android:backgroundTint="@color/player_hud_bg"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textAppearance="@style/TextAppearance.Mh.Num.BodyL"
            android:textColor="@color/text_hi"
            android:visibility="gone"
            tools:text="24:10  +0:38"
            tools:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_appbar_gradient"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/btnClose"
                style="@style/Widget.Mh.IconButton"
                android:contentDescription="@string/cd_close_player"
                android:src="@drawable/ic_keyboard_arrow_down" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Mh.BodyL" />

                <TextView
                    android:id="@+id/playerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Mh.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/adBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_r4"
                android:backgroundTint="@color/ad_badge_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textAppearance="@style/TextAppearance.Mh.Num.Caption"
                android:textColor="@color/ember400"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnCast"
                style="@style/Widget.Mh.IconButton"
                android:contentDescription="@string/cd_cast"
                android:src="@drawable/ic_cast" />

            <ImageView
                android:id="@+id/btnPip"
                style="@style/Widget.Mh.IconButton"
                android:contentDescription="@string/cd_pip"
                android:src="@drawable/ic_picture_in_picture_alt" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipAd"
                style="@style/Widget.Mh.Pill.Ember"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/skip_button_height"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold"
                android:visibility="gone"
                app:cornerRadius="@dimen/radius_badge_sm" />

            <LinearLayout
                android:id="@+id/upNextCard"
                android:layout_width="@dimen/upnext_card_width"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_r12"
                android:backgroundTint="@color/upnext_card_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.streamingappzb.ui.widget.CountdownRingView
                        android:id="@+id/upNextRing"
                        android:layout_width="@dimen/upnext_ring"
                        android:layout_height="@dimen/upnext_ring" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/up_next"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.Mh.Micro.Eleven"
                            android:textColor="@color/text_mid" />

                        <TextView
                            android:id="@+id/upNextEpisode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold"
                            android:textColor="@color/text_hi" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpNextCancel"
                        style="@style/Widget.Mh.Pill.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/action_cancel"
                        android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpNextPlay"
                        style="@style/Widget.Mh.Pill.Ember"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="@string/action_play_now"
                        android:textAppearance="@style/TextAppearance.Mh.Caption.Semibold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/appbar_solid"
            android:orientation="vertical"
            android:paddingStart="@dimen/player_controls_padding_h"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/player_controls_padding_h"
            android:paddingBottom="10dp">

            <com.example.streamingappzb.ui.widget.SeekRailView
                android:id="@+id/seekRail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seek_touch_height" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Caption" />

                <LinearLayout
                    android:id="@+id/transport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnReplay10"
                        style="@style/Widget.Mh.IconButton"
                        android:contentDescription="@string/cd_back_10"
                        android:src="@drawable/ic_replay_10" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayPause"
                        style="@style/Widget.Mh.Pill.Ember"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@string/cd_play"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        app:cornerRadius="@dimen/radius_pill"
                        app:icon="@drawable/ic_play_arrow_fill"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="@dimen/icon_xl" />

                    <ImageView
                        android:id="@+id/btnForward10"
                        style="@style/Widget.Mh.IconButton"
                        android:contentDescription="@string/cd_forward_10"
                        android:src="@drawable/ic_forward_10" />
                </LinearLayout>

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Mh.Num.Caption" />

                <!-- Returns to portrait from here; see the portrait layout for why. -->
                <ImageView
                    android:id="@+id/btnFullscreen"
                    style="@style/Widget.Mh.IconButton"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/cd_fullscreen"
                    android:src="@drawable/ic_fullscreen_exit" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubtitles"
                    style="@style/Widget.Mh.Pill.PlayerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:contentDescription="@string/cd_subtitles"
                    android:text="@string/subtitles_english"
                    app:icon="@drawable/ic_closed_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuality"
                    style="@style/Widget.Mh.Pill.QualityChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:layout_marginStart="@dimen/gap_button_tight"
                    android:contentDescription="@string/cd_quality"
                    app:icon="@drawable/ic_speed" />

                <!-- Only shown when the title resolved to more than one legal source. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSource"
                    style="@style/Widget.Mh.Pill.PlayerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:layout_marginStart="@dimen/gap_button_tight"
                    android:contentDescription="@string/cd_switch_source"
                    android:visibility="gone"
                    app:icon="@drawable/ic_swap"
                    tools:text="Source 1/3"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.Mh.Pill.PlayerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_chip_height"
                    android:layout_marginStart="@dimen/gap_button_tight"
                    android:contentDescription="@string/cd_next_episode"
                    android:text="@string/action_next"
                    app:icon="@drawable/ic_skip_next" />

                <!-- The data cost stays on screen in landscape too (PRD §8.4). -->
                <TextView
                    android:id="@+id/dataNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Mh.Caption"
                    android:textColor="@color/text_low" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
