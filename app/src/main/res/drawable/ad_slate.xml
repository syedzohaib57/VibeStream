<?xml version="1.0" encoding="utf-8"?>
<!--
  Ad slate — PlayerScreen.jsx: linear-gradient(135deg, #17807C, #13101A).
  Shown behind the "Advertisement" label while a creative buffers.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0h100v100h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="100"
                android:endY="100"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="@color/ad_slate_start"
                    android:offset="0" />
                <item
                    android:color="@color/ad_slate_end"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
