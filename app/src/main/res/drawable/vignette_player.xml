<?xml version="1.0" encoding="utf-8"?>
<!--
  Player-frame vignette — PlayerScreen.jsx:
  radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,.55))
  The 100x100 viewport stretched to a 16:9 frame yields the ellipse.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0h100v100h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="71"
                android:type="radial">
                <item
                    android:color="@color/transparent"
                    android:offset="0" />
                <item
                    android:color="@color/transparent"
                    android:offset="0.4" />
                <item
                    android:color="@color/player_vignette_edge"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
