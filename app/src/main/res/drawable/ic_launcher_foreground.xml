<?xml version="1.0" encoding="utf-8"?>
<!--
  MovieHub mark — the design's own thumbnail device: three poster tiles with the
  middle one lit ember, like a dark row of posters lit by the screen.
  (ui_kits/MovieHub thumbnail: three rounded rects, centre #FF8A2B.)

  108dp viewport; all content sits inside the 66dp adaptive safe zone (21..87).
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Projector halo behind the lit poster -->
    <path android:pathData="M22,26h64v56h-64z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32"
                android:type="radial">
                <item
                    android:color="#59FF8A2B"
                    android:offset="0" />
                <item
                    android:color="#1FFF8A2B"
                    android:offset="0.55" />
                <item
                    android:color="#00FF8A2B"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left poster -->
    <path
        android:fillColor="#3A3A42"
        android:pathData="M25,40 H37 A3,3 0 0 1 40,43 V65 A3,3 0 0 1 37,68 H25 A3,3 0 0 1 22,65 V43 A3,3 0 0 1 25,40 Z" />

    <!-- Centre poster — the lit one -->
    <path
        android:fillColor="#FF8A2B"
        android:pathData="M48,40 H60 A3,3 0 0 1 63,43 V65 A3,3 0 0 1 60,68 H48 A3,3 0 0 1 45,65 V43 A3,3 0 0 1 48,40 Z" />

    <!-- Right poster -->
    <path
        android:fillColor="#3A3A42"
        android:pathData="M71,40 H83 A3,3 0 0 1 86,43 V65 A3,3 0 0 1 83,68 H71 A3,3 0 0 1 68,65 V43 A3,3 0 0 1 71,40 Z" />
</vector>
