<?xml version="1.0" encoding="utf-8"?>
<!--
  Behind the seek rail, the chips and the data note. Angle 90 runs bottom to top.
  Deeper than the top scrim because it carries more text over more of the frame.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="@color/player_scrim_mid"
        android:endColor="@color/transparent"
        android:startColor="@color/player_scrim_deep"
        android:type="linear" />
</shape>
