<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero vertical scrim — HomeScreen.jsx:
  linear-gradient(180deg, transparent 34%, rgba(5,5,5,.62) 62%, var(mh-night-900) 97%)
  The 100x100 viewport stretches to the hero's real bounds.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0h100v100h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="100"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="@color/transparent"
                    android:offset="0" />
                <item
                    android:color="@color/transparent"
                    android:offset="0.34" />
                <item
                    android:color="@color/hero_scrim_mid"
                    android:offset="0.62" />
                <item
                    android:color="@color/night900"
                    android:offset="0.97" />
                <item
                    android:color="@color/night900"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
