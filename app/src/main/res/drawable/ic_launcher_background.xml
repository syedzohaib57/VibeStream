<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background — true black lit warm from the upper right, the same
  relationship the hero banner has (PRD §2.1: one ember accent on night900).
  Kept broad because adaptive backgrounds are cropped by the launcher's mask.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#050505"
        android:pathData="M0,0h108v108h-108z" />

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="82"
                android:centerY="16"
                android:gradientRadius="78"
                android:type="radial">
                <item
                    android:color="#33FFB15C"
                    android:offset="0" />
                <item
                    android:color="#14FF8A2B"
                    android:offset="0.5" />
                <item
                    android:color="#00050505"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
