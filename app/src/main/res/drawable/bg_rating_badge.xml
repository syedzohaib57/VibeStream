<?xml version="1.0" encoding="utf-8"?>
<!--
  The rating chip on a poster and in the hero metadata row.

  A dark fill rather than a transparent one: it sits over artwork we do not control, and a
  score has to stay legible over a bright poster as well as a dark one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="4dp" />
    <solid android:color="@color/rating_badge_bg" />
</shape>
