<?xml version="1.0" encoding="utf-8"?>
<!--
  The surface behind a person's portrait.

  It shows while the photo decodes, and remains visible for the many TMDB people who have
  no photo at all — so it has to read as a deliberate empty cell, not a failed image.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_poster_grid" />
    <solid android:color="@color/poster_placeholder" />
</shape>
