<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Exactly the permissions the features require, and nothing else. The design's
      permission-model card is explicit that location, camera, contacts, phone state,
      all-files access and nearby devices are NEVER requested — none of them appear here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Runtime permission on API 33+. Asked contextually, just before the first download
      notification would appear — never at launch. Downloads work either way.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MhDownloadService fetches episodes for offline playback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Held by Media3's DownloadService while a fetch is in flight. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      No storage permission: downloads live in app-private filesDir, so they are removed
      with the app and never touch shared media.

      The advertising ID is explicitly removed rather than merely absent, so its absence
      is provable in the merged manifest for the Play Data Safety declaration. The ad
      stack is a local controller over Media3, not an SDK, and identifies nobody.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!--
      Package visibility (Android 11+).

      Without this, getPackageInfo() and getLaunchIntentForPackage() fail for every
      package not declared here, so "is Netflix installed?" would silently answer no and
      every provider hand-off would fall back to the web — quietly, with nothing in the
      logs. Only streaming apps we may hand off to are listed; this is not a broad
      QUERY_ALL_PACKAGES, which Play restricts and which we do not need.
    -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.google.android.videos" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.tubitv" />
        <package android:name="tv.pluto.android" />
        <package android:name="com.cbs.ca" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.mubi" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.sonyliv" />
        <package android:name="com.jio.media.ondemand" />
        <package android:name="com.tv.v18.viola" />

        <!-- So the web fallback can resolve a browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MovieHubApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovieHub">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MovieHub.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Title detail. Separate from the tab host, which is what keeps the bottom nav off
          it (PRD §4), and the target for moviehub://title/{id} plus the https Share link.
        -->
        <!-- Real catalogue screens. -->
        <activity
            android:name=".ui.media.MediaDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MovieHub" />

        <activity
            android:name=".ui.media.TrailerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MovieHub" />

        <!--
          Browse: a genre, a studio or a network. One Activity for all three because they
          are the same /discover request with a different parameter.
        -->
        <activity
            android:name=".ui.browse.BrowseActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MovieHub" />

        <!-- A person and their filmography, from a cast or crew tap on a title screen. -->
        <activity
            android:name=".ui.person.PersonActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MovieHub" />

        <activity
            android:name=".ui.title.TitleActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="title"
                    android:scheme="moviehub" />
            </intent-filter>

            <!--
              The Share link (FR-108). Not autoVerify yet: verifying it as an App Link
              needs an assetlinks.json served from the host, which does not exist until
              the domain does.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="moviehub.app"
                    android:pathPrefix="/title/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          The player. configChanges for orientation because rotating goes fullscreen with
          the same controls rather than recreating the surface (PRD §6.3), and
          supportsPictureInPicture because PiP is real here rather than a toast.
        -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MovieHub.Player">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="play"
                    android:scheme="moviehub" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="moviehub.app"
                    android:pathPrefix="/play/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          Downloads run as a dataSync foreground service, which API 34+ requires to be
          typed. stopWithTask=false so a fetch survives the task being swiped away.
        -->
        <service
            android:name=".data.download.MhDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>

</manifest>
